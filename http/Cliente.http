@baseUrl = http://localhost:8080
@token = TOKEN

# Consultar meus dados
GET {{baseUrl}}/clientes/me
Authorization: Bearer {{token}}
Content-Type: application/json


# Atualizar meus dados
PUT {{baseUrl}}/clientes/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Cliente Teste 2",
  "email": "cliente2@teste.com",
  "cpf": "12345678905",
  "dataNascimento": "2000-05-20"
}


# Alterar minha senha
PATCH {{baseUrl}}/clientes/me/senha
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "senhaAtual": "Cliente@123",
  "senhaNova": "SenhaNova@456",
  "confirmarSenha": "SenhaNova@456"
}


